# ---- Build output ----
build/
builds/
build-*/
out/
cmake-build-*/

# ---- CMake generated ----
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CMakeUserPresets.json
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
Testing/
.cache/

# ---- Compiled output (MSVC / Ninja / nvcc) ----
*.o
*.obj
*.exe
*.dll
*.lib
*.exp
*.a
*.pdb
*.ilk
*.idb
*.pch
*.gch
*.d
*.log
*.cubin
*.fatbin
*.spv

# Keep model files in assets/ (the *.obj rule above is for compiler output)
!assets/**/*.obj

# Big models you only want locally (not committed)
assets/local/

# ---- Editors and IDEs ----
.vs/
*.user
*.suo
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/

# ---- Profiling and debugging captures ----
*.rdc
*.nsys-rep
*.ncu-rep

# ---- OS junk ----
Thumbs.db
desktop.ini
.DS_Store

# ---- Temporary files ----
*.tmp
*.bak
*.swp
